# ─────────────────────────────────────────────────────────
# NexusMarket frontend environment.
# Copy to .env.local for local dev; the .local suffix keeps
# Next.js from leaking secrets into git accidentally.
# ─────────────────────────────────────────────────────────

# Public API base URL — exposed to the browser. Required.
# In dev the API runs on :4000 by default (see ../docker-compose.yml +
# ../backend/.env.example). In prod, point this at the gateway.
NEXT_PUBLIC_API_BASE=http://localhost:4000

# Optional server-side override. Useful when the frontend container
# can reach the API over a private hostname (e.g. http://api:4000)
# while browsers must hit the public NEXT_PUBLIC_API_BASE. Leave
# blank to fall back to NEXT_PUBLIC_API_BASE.
API_BASE_INTERNAL=
