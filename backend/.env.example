# ─────────────────────────────────────────────────────────
# NexusMarket backend environment
# Copy to .env and fill in real values for production
# ─────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=debug

# Frontend origin for CORS
CORS_ORIGIN=http://localhost:3000

# Postgres (matches docker-compose defaults)
DATABASE_URL=postgresql://nexus:nexus_dev_password@localhost:5432/nexusmarket?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT — generate with: openssl rand -base64 64
JWT_ACCESS_SECRET=change_me_in_production_at_least_64_chars_long_random_string_here
JWT_REFRESH_SECRET=change_me_in_production_different_64_chars_long_random_string_here
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# OAuth providers (PR#13 will use these)
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_DISCORD_CLIENT_ID=
OAUTH_DISCORD_CLIENT_SECRET=
OAUTH_STEAM_API_KEY=

# Mail
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="NexusMarket <noreply@nexusmarket.local>"

# S3-compatible storage (MinIO in dev)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=nexus_minio
S3_SECRET_KEY=nexus_minio_password
S3_BUCKET=nexusmarket

# Payments — left empty in dev, fill in PR#10
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
CRYPTOCLOUD_API_KEY=
CRYPTOCLOUD_SHOP_ID=

# Bot integrations
TELEGRAM_BOT_TOKEN=
DISCORD_WEBHOOK_URL=
